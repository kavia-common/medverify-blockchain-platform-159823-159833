# Backend API configuration
MED_API_SECRET_KEY=your-very-secret-key
MED_API_ALGORITHM=HS256
MED_API_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration (comma-separated origins or '*' for all)
CORS_ALLOW_ORIGINS=*

# Database path - default points to sibling database container's SQLite file
# Provide an absolute path if running in a different environment
SQLITE_DB=../medverify-blockchain-platform-159823-159832/medical_prescription_database/myapp.db

# Solana network for stub integration: mainnet-beta | testnet | devnet | localnet
SOLANA_NETWORK=devnet

# Metadata
APP_TITLE=Medical Prescription Backend
APP_DESCRIPTION=Backend API for creating and verifying medical prescriptions with Solana integration (stub).
APP_VERSION=0.1.0
